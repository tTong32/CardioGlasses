ELEVENLABS_API_KEY=
# Optional: defaults to a stock voice and the low-latency flash model.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# The FinchNode demo API needs no key. Set FINCHNODE_ENABLED=0 to use data/patient.json only.
FINCHNODE_API_KEY=
FINCHNODE_BASE_URL=https://api.finchnode.com/demo/v1
FINCHNODE_PATIENT_ID=patient-demo-polypharmacy
FINCHNODE_ENABLED=1
ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///data/app.db
BACKEND_URL=http://127.0.0.1:8000
SERIAL_PORT=
SAMPLE_RATE_HZ=50
